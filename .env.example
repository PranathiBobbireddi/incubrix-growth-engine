# ==============================================================================
# IncuBrix Growth Engine - Environment Configuration Template
# ==============================================================================
# NOTE: The engine runs fully without any external API keys in offline mode.
# If keys are supplied, live live-check integrations are enabled.
# ==============================================================================

# Optional: YouTube Data API v3 (for automated live channel metadata fetching)
YOUTUBE_API_KEY=

# Optional: Gemini API Key (for LLM-assisted hyper-personalization)
GEMINI_API_KEY=

# Execution Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Outgoing test mailbox for Seed Test Simulation
TEST_SEED_EMAIL=seed-test@incubrix-testing.local
TEST_SEED_LINKEDIN=https://linkedin.com/in/incubrix-test-audit
TEST_SEED_YOUTUBE=https://youtube.com/@incubrix_seed_audit
